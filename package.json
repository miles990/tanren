{
  "name": "tanren",
  "version": "0.1.0",
  "description": "Minimal AI agent framework with built-in learning. Forged through experience.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tanren": "dist/cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "npm run clean && tsc -p tsconfig.test.json && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "gates"
  ],
  "keywords": [
    "ai",
    "agent",
    "framework",
    "learning",
    "autonomous"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "@hono/node-server": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.18",
    "zod": "^4.4.3"
  }
}
